#!/bin/sh

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BIN_DIR="$SCRIPT_DIR/../bin"

reject_media_command() {
  skip_value=0
  for arg in "$@"; do
    if [ "$skip_value" -eq 1 ]; then
      skip_value=0
      continue
    fi
    case "$arg" in
      --host|--port|--profile|--scheme)
        skip_value=1
        ;;
      --host=*|--port=*|--profile=*|--scheme=*|--allow-insecure-http|--tls-insecure)
        ;;
      --*)
        ;;
      media)
        echo "Media commands are not available in this skill package." >&2
        exit 2
        ;;
      *)
        return
        ;;
    esac
  done
}

reject_media_command "$@"

# 桌面端设置页注入的连接参数：未显式传参时补默认值
has_flag() {
  flag=$1
  shift
  for arg in "$@"; do
    case "$arg" in
      "$flag"|"$flag"=*) return 0 ;;
    esac
  done
  return 1
}

if [ -n "${FNOS_HOST:-}" ] && ! has_flag --host "$@"; then
  set -- --host "$FNOS_HOST" "$@"
fi
if [ -n "${FNOS_PORT:-}" ] && ! has_flag --port "$@"; then
  set -- --port "$FNOS_PORT" "$@"
fi
if [ -n "${FNOS_SCHEME:-}" ] && ! has_flag --scheme "$@"; then
  set -- --scheme "$FNOS_SCHEME" "$@"
fi

OS=$(uname -s)
ARCH=$(uname -m)

case "$OS:$ARCH" in
  Darwin:arm64)
    TARGET="$BIN_DIR/trim-cli-darwin-arm64"
    ;;
  Darwin:x86_64)
    TARGET="$BIN_DIR/trim-cli-darwin-x64"
    ;;
  Linux:x86_64)
    TARGET="$BIN_DIR/trim-cli-linux-x64"
    ;;
  Linux:aarch64|Linux:arm64)
    TARGET="$BIN_DIR/trim-cli-linux-arm64"
    ;;
  *)
    echo "Unsupported platform for ./scripts/trim-cli: $OS $ARCH" >&2
    exit 1
    ;;
esac

if [ ! -f "$TARGET" ]; then
  echo "Missing packaged binary: $TARGET" >&2
  exit 1
fi

# 安装包解压后可能丢失可执行位，这里兜一次
if [ ! -x "$TARGET" ]; then
  chmod +x "$TARGET" 2>/dev/null || true
fi

if [ ! -x "$TARGET" ]; then
  echo "Packaged binary is not executable: $TARGET" >&2
  exit 1
fi

exec "$TARGET" "$@"
